{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/client",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/server/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
