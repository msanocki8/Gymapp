{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/share/:token",
      "destination": "/share/[token]"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
