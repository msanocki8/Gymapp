{
  "expo": {
    "name": "GymApp",
    "slug": "GymApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gymapp-logo.png",
    "scheme": "gymapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gymapp-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070908",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GymApp używa aparatu do skanowania kodów produktów.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "GymApp używa aparatu do analizy posiłków.",
          "photosPermission": "GymApp używa wybranego zdjęcia wyłącznie do analizy posiłku.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070908",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
